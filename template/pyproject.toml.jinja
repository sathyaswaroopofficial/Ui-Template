# Root of the Python uv workspace. Run `uv sync` here once; it creates .venv for all Python packages.
[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">=3.12"
dependencies = [
  "{{ project_slug }}-api",
{%- if project_type == 'ml' %}
  "ml-core",
{%- endif %}
]

[dependency-groups]
dev = [
  "pytest>=8.3",
  "httpx>=0.27",
  "ruff>=0.6",
  "mypy>=1.11",
]

[tool.uv]
package = false

[tool.uv.workspace]
members = ["apps/api"{% if project_type == 'ml' %}, "ml"{% endif %}]

[tool.uv.sources]
{{ project_slug }}-api = { workspace = true }
{%- if project_type == 'ml' %}
ml-core = { workspace = true }
{%- endif %}

[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP", "SIM", "N"]
ignore = ["B008"]  # FastAPI's Depends() in defaults is idiomatic

[tool.ruff.lint.isort]
known-first-party = ["app"]

[tool.pytest.ini_options]
testpaths = ["apps/api/tests"{% if project_type == 'ml' %}, "ml/tests"{% endif %}]
addopts = "-q --import-mode=importlib"
pythonpath = ["apps/api"]
